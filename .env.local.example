# Salin jadi .env.local, isi nilainya. JANGAN commit .env.local (pastikan ada di .gitignore).

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only (cron, sync Gmail, insert job_listings). Jangan pernah diawali NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI (100% tier gratis) ---
# Embedding: Google Gemini. Buat key di https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# LLM (parsing CV, cover letter, klasifikasi email): Groq. Buat key di https://console.groq.com/keys
GROQ_API_KEY=
# llama-3.3-70b-versatile sudah dipensiunkan Groq (16 Agu 2026)
GROQ_MODEL=openai/gpt-oss-120b

# --- Google OAuth (Gmail) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# --- Keamanan ---
# Untuk enkripsi refresh token Gmail (AES-256-GCM). Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Untuk mengamankan endpoint /api/cron/*. Generate: openssl rand -hex 32
CRON_SECRET=

# --- Job board APIs (isi saat Tahap 2) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
RAPIDAPI_KEY=

# --- Rate limit (opsional) ---
# Tanpa ini, rate limit memakai memori lokal (cukup untuk development, tidak andal di Vercel).
# Akun gratis: https://upstash.com -> Redis -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Batas unggah CV per jam per user (default 5). Naikkan sementara saat testing.
CV_PARSE_LIMIT_PER_HOUR=5

# --- Kalibrasi Match Score (opsional) ---
# skor = (cos - FLOOR) / SPAN * 100. Atur setelah melihat angka "cos" di CV Studio.
MATCH_SCORE_FLOOR=0.45
MATCH_SCORE_SPAN=0.25
