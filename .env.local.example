# Salin jadi .env.local, isi nilainya. JANGAN commit .env.local (pastikan ada di .gitignore).

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only (cron, sync Gmail, insert job_listings). Jangan pernah diawali NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI (100% tier gratis) ---
# Embedding: Google Gemini. Buat key di https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# LLM (parsing CV, cover letter, klasifikasi email): Groq. Buat key di https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google OAuth (Gmail) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# --- Keamanan ---
# Untuk enkripsi refresh token Gmail (AES-256-GCM). Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Untuk mengamankan endpoint /api/cron/*. Generate: openssl rand -hex 32
CRON_SECRET=

# --- Job board APIs (isi saat Tahap 2) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
RAPIDAPI_KEY=
